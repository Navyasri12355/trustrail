# ── Razorpay ─────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX

# ── Ed25519 keypair (generate with: python -m backend.crypto.keys) ────────────
ED25519_PRIVATE_KEY_HEX=
ED25519_PUBLIC_KEY_HEX=

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev (SQLite — no Docker needed):
DATABASE_URL=sqlite:///./trustrail.db

# Docker / production (Postgres — set these and docker compose handles the rest):
# DATABASE_URL is constructed automatically by docker-compose.yml from the three
# vars below. Only set DATABASE_URL manually if you're NOT using docker compose.
POSTGRES_DB=trustrail
POSTGRES_USER=trustrail
POSTGRES_PASSWORD=changeme_in_production

# ── App ───────────────────────────────────────────────────────────────────────
# Single-tenant mode (backward compatibility)
TRUSTRAIL_MERCHANT_ID=mrc_demo_001
TRUSTRAIL_MERCHANT_NAME=Demo Merchant

# Multi-tenant mode: Create merchants via POST /merchants API
# Each merchant has their own Razorpay credentials stored in the database
